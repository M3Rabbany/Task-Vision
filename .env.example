# Salin file ini menjadi .env, lalu isi nilainya.
# Jangan commit file .env.

DB_PASSWORD=
JWT_SECRET=

# --- HTTPS (reverse proxy Caddy) ---
# CADDYFILE=Caddyfile.local memakai sertifikat internal (self-signed) untuk
# localhost / IP. Cocok untuk lokal & testing; browser akan memberi peringatan
# sampai root CA Caddy dipercaya (lihat README).
CADDYFILE=Caddyfile.local

# Hostname/IP yang dilayani sertifikat lokal. Tambahkan IP jaringan jika aplikasi
# diakses dari perangkat lain, misalnya: LOCAL_HOSTS=localhost, 192.168.1.10
LOCAL_HOSTS=localhost

# Untuk produksi dengan domain publik, hapus tanda # pada baris di bawah ini
# dan isi nilainya. Port 80/443 harus terbuka dan A/AAAA record sudah mengarah
# ke server agar Caddy bisa mendapat sertifikat Let's Encrypt otomatis.
# CADDYFILE=Caddyfile.prod
# DOMAIN=taskvision.example.com
# APP_FRONTEND_URL=https://taskvision.example.com

# Opsional: konfigurasi SMTP untuk email selamat datang dan reset password.
# Untuk Gmail, gunakan App Password (bukan password akun biasa).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Base URL yang dipakai pada tautan di dalam email.
# Saat memakai CADDYFILE=Caddyfile.prod, ganti ke https://domain-anda.
APP_FRONTEND_URL=https://localhost

# Opsional: akun admin yang dibuat otomatis saat database masih kosong.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
